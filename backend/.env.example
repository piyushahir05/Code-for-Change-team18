# Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

# Direct PostgreSQL connection string (Supabase -> Project Settings -> Database)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/postgres

# AI provider: mock | openai | groq
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000

ENVIRONMENT=development

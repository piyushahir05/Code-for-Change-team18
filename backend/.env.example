# Direct PostgreSQL connection to the team's Supabase project (SQLAlchemy).
# This MUST point at the same Supabase project your teammate ran
# schema.sql / init_database_full.sql against - get it from
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# (use the "URI" format, then swap postgresql:// for postgresql+psycopg2://).
DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Optional - matches the teammate's existing backend/.env.example naming.
# Not used by the SQLAlchemy data path (DATABASE_URL is); kept for parity /
# any future direct use of the Supabase client.
SUPABASE_URL=
SUPABASE_KEY=

# This schema has no Supabase Auth link (users.password_hash is local) -
# this backend issues and verifies its own JWTs. Generate a long random
# value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI provider: mock | openai | groq
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000

ENVIRONMENT=development
